003400 1000-CONNECT-DB.
003500     DISPLAY "ESTABLISHING DB2 DATABASE CONNECTION...".
003600     EXEC SQL
003700         CONNECT TO "CUST_PROD_DB"
003800     END-EXEC.
003900     IF SQLCODE NOT = 0
004000        MOVE "99" TO LK-DB-STATUS
004100     ELSE
004200        MOVE "00" TO LK-DB-STATUS
004300     END-IF.
004400 2000-QUERY-ACCOUNTS.
004500     EXEC SQL
004600         SELECT BALANCE, STATUS 
004700         INTO :SQL-BAL, :SQL-STATUS-CODE
004800         FROM CUSTOMER_TABLE
004900         WHERE CUSTOMER_ID = :SQL-CUST-ID
005000     END-EXEC.
005100     IF SQLCODE = 0
005200        DISPLAY "RETRIEVED DATA SUCCESSFULLY."
005300     ELSE
005400        PERFORM 8000-LOG-ERROR
005500     END-IF.
005600 3000-UPDATE-METRICS.
005700     EXEC SQL
005800         UPDATE PERFORMANCE_METRICS_TABLE
005900         SET QUERY_COUNT = QUERY_COUNT + 1
006000         WHERE MODULE_NAME = "DB-INTERFACE"
006100     END-EXEC.
006200 8000-LOG-ERROR.
006300     MOVE "DB TRANSACTION ERROR DETECTED." TO DB-LOG-RECORD.
006400     WRITE DB-LOG-RECORD.
