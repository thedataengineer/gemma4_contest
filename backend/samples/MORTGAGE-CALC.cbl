000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. MORTGAGE-CALC.
000300 ENVIRONMENT DIVISION.
000400 DATA DIVISION.
000500 WORKING-STORAGE SECTION.
000600 01 WS-CALC-WORK-AREAS.
000700    05 WS-MONTHS          PIC 9(4) VALUE 0.
000800    05 WS-TEMP-VAL        PIC 9(9)V9999 VALUE 0.0.
000900    05 WS-DIVISOR         PIC 9(9)V9999 VALUE 0.0.
001000    05 WS-RATE-FACTOR     PIC 9(9)V9999 VALUE 0.0.
001100    05 WS-LOAN-BALANCE    PIC 9(9)V99 VALUE 0.0.
001200 LINKAGE SECTION.
001300 01 LK-CLIENT-RECORD.
001400    05 LK-ACC-NUM         PIC X(10).
001500    05 LK-BALANCE         PIC 9(7)V99.
001600    05 LK-RATE            PIC 9(2)V999.
001700 01 LK-INTEREST-OUT       PIC 9(7)V99.
001800 01 LK-STATUS-CODE        PIC X(2).
001900 PROCEDURE DIVISION USING LK-CLIENT-RECORD, LK-INTEREST-OUT, LK-STATUS-CODE.
002000 0000-CALCULATE.
002100     MOVE "00" TO LK-STATUS-CODE
002200     IF LK-RATE <= 0.0 OR LK-RATE > 30.00
002300        MOVE "01" TO LK-STATUS-CODE
002400        PERFORM 8000-HANDLE-INVALID-RATE
002500     ELSE
002600        IF LK-BALANCE <= 0.0
002700           MOVE "02" TO LK-STATUS-CODE
002800           PERFORM 8100-HANDLE-INVALID-BALANCE
002900        ELSE
003000           PERFORM 1000-PROCESS-CALCULATIONS
003100        END-IF
003200     END-IF
003300     GOBACK.
003400 1000-PROCESS-CALCULATIONS.
003500     DISPLAY "COMMENCING COMPLEX AMORTIZATION ALGORITHM..."
003600     PERFORM 2000-COMPUTE-RATE-FACTOR
003700     PERFORM 3000-COMPUTE-MONTHLY-TERM
003800     IF WS-DIVISOR = 0.0
003900        MOVE "99" TO LK-STATUS-CODE
004000     ELSE
004100        PERFORM 4000-APPLY-AMORTIZATION-FORMULA
004200     END-IF.
004300 2000-COMPUTE-RATE-FACTOR.
004400     COMPUTE WS-RATE-FACTOR = LK-RATE / 1200.0.
004500 3000-COMPUTE-MONTHLY-TERM.
004600     MOVE 360 TO WS-MONTHS.
004700     COMPUTE WS-TEMP-VAL = (1.0 + WS-RATE-FACTOR).
004800     COMPUTE WS-DIVISOR = 1.0.
004900     PERFORM VARYING WS-MONTHS FROM 360 BY -1 UNTIL WS-MONTHS <= 0
005000        COMPUTE WS-DIVISOR = WS-DIVISOR * WS-TEMP-VAL
005100     END-PERFORM.
005200 4000-APPLY-AMORTIZATION-FORMULA.
005300     COMPUTE LK-INTEREST-OUT = LK-BALANCE * (WS-RATE-FACTOR * WS-DIVISOR) / (WS-DIVISOR - 1.0).
005400     IF LK-INTEREST-OUT > LK-BALANCE
005500        MOVE "88" TO LK-STATUS-CODE
005600        DISPLAY "CRITICAL: AMORTIZATION RESULT EXCEEDS PRINCIPAL!"
005700     END-IF.
005800 8000-HANDLE-INVALID-RATE.
005900     DISPLAY "WARNING: INVALID INTEREST RATE DETECTED: " LK-RATE.
006000     MOVE 0.0 TO LK-INTEREST-OUT.
006100 8100-HANDLE-INVALID-BALANCE.
006200     DISPLAY "WARNING: INVALID PRINCIPAL BALANCE DETECTED: " LK-BALANCE.
006300     MOVE 0.0 TO LK-INTEREST-OUT.
