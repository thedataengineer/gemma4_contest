//DBSYNC   JOB (DB-007),'DAILY DB2 METRICS SYNC',
//             CLASS=A,MSGCLASS=X
//*
//*  Daily DB2 sync — runs DB-INTERFACE to:
//*    - CONNECT TO CUST_PROD_DB
//*    - SELECT BALANCE, STATUS FROM CUSTOMER_TABLE
//*    - UPDATE PERFORMANCE_METRICS_TABLE counters
//*  Any SQLCODE != 0 is appended to PROD.DB.ERR.LOG.
//*
//STEP010  EXEC PGM=DB-INTERFACE
//ERRLOG   DD DSN=PROD.DB.ERR.LOG,
//             DISP=(MOD,KEEP,KEEP)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
